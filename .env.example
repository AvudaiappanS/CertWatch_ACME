# ----- CertWatch Lab configuration (copy to .env and edit) -----
# Generate with:  openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-hex-string

# First-run administrator (used only when the database is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# Domains
PRIMARY_DOMAIN=certwatchlab.in
ALLOWED_RENEWAL_DOMAINS=certwatchlab.in,www.certwatchlab.in
SCAN_ALLOW_PRIVATE=false

# HTTPS cookies: set true once the site is served over HTTPS
SESSION_COOKIE_SECURE=false

# ACME: pebble (local test CA) | staging (Let's Encrypt staging) | production
ACME_MODE=pebble
ACME_EMAIL=you@example.com
# Only after a successful staging run:
ALLOW_PRODUCTION_ACME=false

# Scheduler intervals (hours)
SCAN_INTERVAL_HOURS=6
CT_INTERVAL_HOURS=24
RENEWAL_CHECK_INTERVAL_HOURS=24
RENEW_BEFORE_DAYS=30

# Alerts - test mode is ON by default: alerts are recorded, never sent.
ALERT_TEST_MODE=true
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WEBHOOK_URL=

# Optional
MAX_LOGIN_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=10
